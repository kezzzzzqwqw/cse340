<%- include('partials/header') %>

<section class="page-header">
  <h1><%= pageTitle %></h1>
  <p>Categories group service projects so volunteers can find what interests them.</p>
</section>

<form class="form-card" action="/new-category" method="POST">
  <div class="form-group">
    <label for="name">Category Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      maxlength="100"
      aria-describedby="name-help"
    />
    <p id="name-help" class="form-help">Required. Up to 100 characters.</p>
  </div>

  <div class="form-actions">
    <button type="submit">Create Category</button>
    <a href="/categories" class="btn btn-secondary">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
