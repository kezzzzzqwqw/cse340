<%- include('partials/header') %>

<section class="page-header">
  <h1><%= pageTitle %></h1>
  <p>Learn more about the organizations we partner with.</p>
</section>

<section class="card-grid">
  <% organizations.forEach((org) => { %>
    <div class="card">
      <img src="<%= org.image %>" alt="<%= org.name %>" class="card-image" />
      <div class="card-body">
        <h2><%= org.name %></h2>
        <p><%= org.description %></p>
      </div>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>
