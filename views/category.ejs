<%- include('partials/header') %>

<section class="page-header">
  <h1><%= categoryDetails.name %></h1>
  <p>Service projects in this category.</p>
</section>

<section class="card-grid">
  <% if (projects.length === 0) { %>
    <p>There are no service projects in this category yet.</p>
  <% } %>

  <% projects.forEach((project) => { %>
    <% const formattedDate = project.project_date.toLocaleDateString('en-US', {
         year: 'numeric',
         month: 'long',
         day: 'numeric'
       }); %>
    <div class="card">
      <div class="card-body">
        <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
        <p><strong>Date:</strong> <%= formattedDate %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </div>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>