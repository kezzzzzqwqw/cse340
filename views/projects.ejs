<%- include('partials/header') %>

<section class="page-header">
  <h1><%= pageTitle %></h1>
  <p>Current volunteer opportunities you can join.</p>
</section>

<section class="card-grid">
  <% if (projects.length === 0) { %>
    <p>No service projects are scheduled right now. Please check back soon!</p>
  <% } %>

  <% projects.forEach((project) => { %>
    <% const formattedDate = project.project_date.toLocaleDateString('en-US', {
         year: 'numeric',
         month: 'long',
         day: 'numeric'
       }); %>
    <div class="card">
      <div class="card-body">
        <h2>
          <%= formattedDate %>:
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
        </h2>
        <p><%= project.description %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </div>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>
