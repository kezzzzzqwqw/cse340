<%- include('partials/header') %>

<section class="hero">
  <h1>Welcome to the <%= pageTitle %> of Community Service Hub</h1>
  <p>
    Connecting volunteers with organizations, projects, and causes that make a
    difference. Explore our partner organizations, browse current service
    projects, or find opportunities by category.
  </p>
  <div class="hero-actions">
    <a href="/organizations" class="btn btn-primary">View Organizations</a>
    <a href="/projects" class="btn btn-secondary">View Projects</a>
