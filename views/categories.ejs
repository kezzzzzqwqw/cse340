<%- include('partials/header') %>

<section class="page-header">
  <h1><%= pageTitle %></h1>
  <p>Browse service projects by category.</p>
  <div class="card-actions">
    <a href="/new-category" class="btn btn-primary btn-small">Add New Category</a>
  </div>
</section>

<section class="card-grid">
  <% categories.forEach((category) => { %>
    <div class="card category-card">
      <div class="card-body">
        <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>

        <% if (category.projects.length === 0) { %>
          <p>No projects in this category yet.</p>
        <% } else { %>
          <ul>
            <% category.projects.forEach((project) => { %>
              <% const formattedDate = project.project_date.toLocaleDateString('en-US', {
                   year: 'numeric',
                   month: 'long',
                   day: 'numeric'
                 }); %>
              <li>
                <%= formattedDate %>:
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
              </li>
            <% }) %>
          </ul>
        <% } %>

        <div class="card-actions">
          <a href="/edit-category/<%= category.category_id %>" class="btn btn-secondary btn-small">Edit</a>
        </div>
      </div>
    </div>
  <% }) %>
</section>

<%- include('partials/footer') %>
