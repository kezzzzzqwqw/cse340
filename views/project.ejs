<%- include('partials/header') %>

<section class="page-header">
  <h1><%= project.title %></h1>
</section>

<section class="card-grid">
  <% const formattedDate = project.project_date.toLocaleDateString('en-US', {
       year: 'numeric',
       month: 'long',
       day: 'numeric'
     }); %>
  <div class="card">
    <div class="card-body">
      <p><%= project.description %></p>
      <p><strong>Date:</strong> <%= formattedDate %></p>
      <p><strong>Location:</strong> <%= project.location %></p>
      <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
      </p>

      <% if (categories.length > 0) { %>
        <ul class="tags" aria-label="Categories">
          <% categories.forEach((category) => { %>
            <li><a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
          <% }); %>
        </ul>
      <% } %>

      <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Assign Categories</a></p>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
      <% } %>

      <% if (user) { %>
        <div class="volunteer-box">
          <% if (isVolunteer) { %>
            <p class="volunteer-status"><strong>You are volunteering for this project.</strong></p>
            <form method="POST" action="/project/<%= project.project_id %>/unvolunteer" class="inline-form">
              <button type="submit" class="btn btn-secondary btn-small">Remove me as a volunteer</button>
            </form>
          <% } else { %>
            <form method="POST" action="/project/<%= project.project_id %>/volunteer" class="inline-form">
              <button type="submit" class="btn btn-primary btn-small">Volunteer for this project</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>